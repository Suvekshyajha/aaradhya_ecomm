# ==========================================================================
# AARADHYA - client (Vite) environment template
# Copy this file to client/.env and fill in real values:
#   cp client/.env.example client/.env
# client/.env is git-ignored and must never be committed.
# ==========================================================================

# Production site URL used for SEO canonical URLs and Open Graph tags.
# Example: VITE_SITE_URL=https://www.Aaradhya.com
VITE_SITE_URL=

# Google Analytics 4 measurement ID (Google Analytics > Admin > Data Streams).
# Example: VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Leave empty to disable analytics (e.g. local development).
VITE_GA_MEASUREMENT_ID=

\n.whatmore-shimmer-collections-flex-stories::before,\n.whatmore-shimmer-collections-flex-stories::after { content: \'\'; margin: auto; }\n\n/* ===== NEO skin shimmer: one generic skeleton, per-mode SHAPE keyed off data-wht-mode (mirrors the\n   neo engine\'s generic-DOM + skin-CSS split). Tile size comes from the engine\'s own computeSlideWidthPx\n   via the --sh-tile-w/h vars set inline. ===== */\n.whatmore-shimmer-neo { width: 100%; overflow: hidden; }\n.whatmore-shimmer-neo-heading { width: 200px; margin: 0 auto 16px; background: #e0e0e0; border-radius: 4px; position: relative; overflow: hidden; }\n/* overflow:hidden so the tile row CLIPS to the rail\'s own box \u2014 the rail\'s margin-inline (collection=40,\n   carousel=user value) then holds on BOTH sides; without it the overflowing tiles spill past the right margin. */\n.whatmore-shimmer-neo-rail { display: flex; justify-content: center; align-items: center; gap: var(--sh-gap, 14px); position: relative; overflow: hidden; }\n.whatmore-shimmer-neo-tile { flex: 0 0 auto; width: var(--sh-tile-w, 120px); height: var(--sh-tile-h, 213px); background: #e0e0e0; border-radius: 5px; position: relative; overflow: hidden; }   /* match the render\'s radius (brand_ui_theme round default = 5px) */\n\n/* ALIGNMENT is driven by fill, NOT mode: the tile count comes from the real event count, so when the\n * videos DON\'T fill the rail (few videos \u2192 data-wht-fill="fit") the carousel CENTRES them; when they\n * overflow (data-wht-fill="overflow") it start-aligns like a scroll list \u2014 in BOTH orientations. A scroll\n * list always begins at the first tile; centring an overflowing row would push the leftmost tile half\n * off-screen (the portrait bug). Base is centred; overflow (either orientation) flips to flex-start. */\n.whatmore-shimmer-neo[data-wht-fill="overflow"] .whatmore-shimmer-neo-rail { justify-content: flex-start; }\n/* standard-family rails (a/b/f) centre-hero in PORTRAIT even when overflowing (higher specificity wins over\n * the flex-start above); mosaic rails (c/d, palign="start") keep the start-left scroll. */\n.whatmore-shimmer-neo[data-wht-vp="portrait"][data-wht-palign="center"] .whatmore-shimmer-neo-rail { justify-content: center; }\n/* per-skin tile scale (inline --sh-scale). Some rail skins render every tile at --wht-neo-side-scale\n * (e.g. standard/a = 0.94): the layout box shows smaller AND the flex-gap reads wider (tiles shrink\n * from centre). Skins with no side-scale (e.g. card/b = 1) keep box size + real gap. Mirrors the render. */\n.whatmore-shimmer-neo[data-wht-vp="landscape"] .whatmore-shimmer-neo-tile { transform: scale(var(--sh-scale, 1)); transform-origin: center center; }\n\n/* hoverplay: no alignment override \u2014 the skin uses safe-center (centred when the tiles fit, flush-left\n   once they overflow), which the shimmer\'s base rules already mirror (centre + flex-start on\n   data-wht-fill="overflow"). A forced flex-start here left the shimmer left-aligned while the render\n   centred small sets. */\n\n/* viewmore: wrapped grid, 6 (smaller) tiles in ~3 columns */\n/* viewmore: CENTRED wrapping grid \u2014 tiles wrap by width (landscape 6-in-a-row, portrait ~2 cols), like\n   the real skin (flex-wrap + justify-content:center + padding-inline:12). Collapsed to \u22646 tiles. */\n.whatmore-shimmer-neo[data-wht-mode="viewmore"] .whatmore-shimmer-neo-rail { flex-wrap: wrap; justify-content: center; align-content: flex-start; gap: 20px; padding-inline: 12px; max-height: calc(var(--sh-tile-w) * 16 / 9 + 2px); overflow: hidden; }\n.whatmore-shimmer-neo[data-wht-mode="viewmore"] .whatmore-shimmer-neo-tile { width: var(--sh-tile-w); height: auto; aspect-ratio: 9 / 16; }\n\n/* feed: vertical GRID (mirrors shared-skin-feed) \u2014 2 columns portrait / 3 landscape, page-scroll */\n.whatmore-shimmer-neo[data-wht-mode="feed"] .whatmore-shimmer-neo-rail { display: grid; grid-template-columns: repeat(auto-fit, calc(var(--sh-tile-w) * 1.15)); justify-items: center; justify-content: center; align-items: start; column-gap: 0; row-gap: calc(var(--sh-tile-w) * 0.37); }\n.whatmore-shimmer-neo[data-wht-mode="feed"][data-wht-vp="landscape"] .whatmore-shimmer-neo-rail { grid-template-columns: repeat(auto-fit, calc(var(--sh-tile-w) * 1.1)); row-gap: calc(var(--sh-tile-w) * 0.31); }\n.whatmore-shimmer-neo[data-wht-mode="feed"] .whatmore-shimmer-neo-tile { width: var(--sh-tile-w); height: auto; aspect-ratio: 9 / 16; }\n.whatmore-shimmer-neo[data-wht-mode="feed"] .whatmore-shimmer-neo-tile:nth-child(n+9) { display: none; }\n\n/* coverflow: fan \u2014 centre on top, neighbours behind + scaled (5 landscape / 3 portrait) */\n.whatmore-shimmer-neo[data-wht-mode="coverflow"] .whatmore-shimmer-neo-rail { gap: 0; height: var(--sh-tile-h); }\n.whatmore-shimmer-neo[data-wht-mode="coverflow"] .whatmore-shimmer-neo-tile { position: absolute; left: 50%; top: 50%; }\n.whatmore-shimmer-neo[data-wht-mode="coverflow"][data-wht-vp="landscape"] .whatmore-shimmer-neo-tile:nth-child(n+6) { display: none; }\n.whatmore-shimmer-neo[data-wht-mode="coverflow"][data-wht-vp="landscape"] .whatmore-shimmer-neo-tile:nth-child(3) { transform: translate(-50%, -50%) scale(1); z-index: 5; }\n.whatmore-shimmer-neo[data-wht-mode="coverflow"][data-wht-vp="landscape"] .whatmore-shimmer-neo-tile:nth-child(2) { transform: translate(-50%, -50%) translateX(-64%) scale(0.9); z-index: 4; }\n.whatmore-shimmer-neo[data-wht-mode="coverflow"][data-wht-vp="landscape"] .whatmore-shimmer-neo-tile:nth-child(4) { transform: translate(-50%, -50%) translateX(64%) scale(0.9); z-index: 4; }\n.whatmore-shimmer-neo[data-wht-mode="coverflow"][data-wht-vp="landscape"] .whatmore-shimmer-neo-tile:nth-child(1) { transform: translate(-50%, -50%) translateX(-128%) scale(0.8); z-index: 3; }\n.whatmore-shimmer-neo[data-wht-mode="coverflow"][data-wht-vp="landscape"] .whatmore-shimmer-neo-tile:nth-child(5) { transform: translate(-50%, -50%) translateX(128%) scale(0.8); z-index: 3; }\n.whatmore-shimm
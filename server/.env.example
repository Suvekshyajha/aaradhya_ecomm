# ==========================================================================
# Aaradhya - server environment template
# Copy this file to server/.env and fill in real values:
#   cp server/.env.example server/.env
# server/.env is git-ignored and must never be committed.
# ==========================================================================

# ---- HTTP server ---------------------------------------------------------
# Port the API listens on (optional, defaults to 5000)
PORT=5000
# Origin allowed through CORS (optional, defaults to http://localhost:5173)
CLIENT_URL=http://localhost:5173
# Set to "production" on HTTPS deployments so the auth cookie is issued with
# secure + sameSite "none". Localhost development must leave this unset (or
# any non-production value) or the browser will refuse to store the cookie.
NODE_ENV=development

# ---- MongoDB -------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# ---- Auth ----------------------------------------------------------------
# Secret used to sign and verify JWTs. Generate a strong random value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime (optional, defaults to 60m)
JWT_EXPIRES_IN=60m

# ---- eSewa -----------------------------------------------------------------
# ESEWA_MODE=test            -> UAT endpoints (default; needs eSewa's test
#                               environment to be up)
# ESEWA_MODE=live            -> production endpoints (real merchant keys)
# ESEWA_MODE=mock            -> built-in test gateway inside the app itself.
#                               No real payment URL is ever called; the mock
#                               cashier returns a signed payload that travels
#                               the same server verification. Use this for
#                               development, demos and viva.
ESEWA_MODE=test
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# Optional overrides if eSewa moves its endpoints (defaults shown):
# ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/

# ---- Cloudinary ----------------------------------------------------------
# Get these from https://console.cloudinary.com (required for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
